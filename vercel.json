{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 tools/build_vercel.py",
  "outputDirectory": "dist-vercel",
  "redirects": [{"source":"/","destination":"/play/","permanent":false}],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"Cross-Origin-Opener-Policy","value":"same-origin"},
      {"key":"Cross-Origin-Embedder-Policy","value":"require-corp"},
      {"key":"Cross-Origin-Resource-Policy","value":"same-origin"}
    ]},
    {"source":"/play/build/cricket07.wasm","headers":[{"key":"Content-Type","value":"application/wasm"}]},
    {"source":"/play/game/files/(.*)","headers":[{"key":"Cache-Control","value":"public,max-age=31536000,immutable"}]},
    {"source":"/play/game/manifest.json","headers":[{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/data/playtest.json","headers":[{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/play/rosters/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]}
  ]
}
